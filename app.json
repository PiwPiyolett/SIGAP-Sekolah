{
  "expo": {
    "name": "SIPERKASA Sekolah",
    "slug": "sigap-sekolah",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sigapsekolah",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0C1322"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash.png",
          "backgroundColor": "#0C1322",
          "resizeMode": "contain"
        }
      ],
      "expo-font"
    ],
    "android": {
      "package": "com.sigap.school",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0C1322"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sigap.school",
      "buildNumber": "1"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "083812be-8c3e-4e53-9723-5ee636e4aa77"
      }
    },
    "owner": "ariqoba"
  }
}
