# Salin file ini menjadi `.env` lalu isi nilai aslinya.
# JANGAN commit file `.env` ke GitHub (sudah masuk .gitignore).

# === Firebase (dari Firebase Console > Project Settings) ===
EXPO_PUBLIC_FIREBASE_API_KEY=isi_dari_firebase_console
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=sigap-guardian-driver.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=sigap-guardian-driver
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=sigap-guardian-driver.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=angka_panjang
EXPO_PUBLIC_FIREBASE_APP_ID=1:xxx:android:xxx

# === Gemini AI (dari https://aistudio.google.com) ===
EXPO_PUBLIC_GEMINI_API_KEY=isi_api_key_gemini
